{
  "name": "telegram-russian-teacher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --test-scheduled",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "admin": "node scripts/admin.mjs",
    "webhook": "node scripts/webhook.mjs",
    "secrets:sync": "node scripts/sync-secrets.mjs",
    "infisical": "node scripts/infisical.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "grammy": "^1.38.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "miniflare": "5.20261019.0-beta",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
